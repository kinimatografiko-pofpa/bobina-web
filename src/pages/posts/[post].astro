---
import BasePage from '../../layouts/BasePage.astro';
import BlogPost from '../../components/BlogPost.astro';

import { parse } from 'node-html-parser';

import wordpress from '../../wordpress';
import { getCollection } from 'astro:content';

// categorize posts using the slug since slugs are guaranteed unique by wordpress
// this generates prettier urls and makes it easier to find posts
export async function getStaticPaths() {
	const collection = await getCollection('posts');
	if (!collection) return [];

	return collection.map((p) => ({
		params: {
			post: decodeURI(p.id),
		},
		props: {
			post_obj: p.data,
		},
	}));
}

const post = Astro.props.post_obj;
const img = post.featured_image;
const content = {
	title: parse(post.title).text,
	description: wordpress.getExcerptFromPost(post),
	publishDate: post.date,
	author: 'test',
	heroImage: img,
	alt: post.slug,
	text: post.content,
	id: post.ID,
	slug: post.slug,
	tags: post.tags,
	footnotes: post.footnotes,
	categories: wordpress.getCategoriesFromPost(post),
};
---

<BasePage
	title={content.title}
	description={content.description}
	permalink={'/posts/' + content.slug}
	heroImage={content.heroImage}
>
	<BlogPost
		title={content.title}
		author={content.author}
		tags={content.tags}
		publishDate={content.publishDate}
		featuredImage={content.heroImage}
		alt={content.alt}
		text={content.text}
		id={content.id}
		footnotes={content.footnotes}
		categories={content.categories}
	/>
</BasePage>
