---
import ArticleListPage from '../../components/ArticleListPage.astro';
import BasePage from '../../layouts/BasePage.astro';

import wordpress from '../../wordpress';
import { getCollection } from 'astro:content';

// categorize posts using the slug since slugs are guaranteed unique by wordpress
// this generates prettier urls and makes it easier to find posts
export async function getStaticPaths() {
	const categories = await getCollection('categories');
  	if (!categories) return [];

	return categories.map((c) => ({
		params: {
			category: decodeURI(c.id),
		},
		props: {
			category: c.data,
		},
	}));
}

const category = Astro.props.category;

let {
	data: { posts },
} = await wordpress.getPosts(100, '', category.slug);
---

<BasePage
	title={category.name}
	description={category.name}
	permalink={'/categories/' + category.slug}
>
	<ArticleListPage posts={posts} title={category.name} />
</BasePage>
