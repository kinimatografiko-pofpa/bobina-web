---
import BasePage from '../layouts/BasePage.astro';
import OptimizedPicture from '../components/OptimizedPicture.astro';
---

<BasePage title="Eπικοινωνία" permalink="/contact">
	<main>
		<div class="px-5 max-w-[1200px] mx-auto mb-24 mt-10">
			<div
				class="flex justify-around md:flex-nowrap flex-wrap-reverse gap-x-10 gap-y-14"
			>
				<OptimizedPicture
					src="/public/assets/contact.png"
					alt=""
					class="md:max-w-[552px] md:grow-0 grow"
				/>
				<div class="md:max-w-[362px] justify-end md:pt-5 md:pb-7">
					<h1
						class="title-large md:mb-8 mb-10 md:text-left text-center"
					>
						Eπικοινωνία
					</h1>
					<p class="text-body">
						Επικοινωνήστε μαζί μας στην ηλεκτρονική διεύθυνση
						mpompina@gmail.com.
						<br /><br />
						Τα τεύχη της Μπομπίνας διατίθενται δωρεάν στο γραφείο του
						Κινηματογραφικού Τομέα στον ημιώροφο της Πανεπιστημιακής
						Λέσχης (Ιπποκράτους 15 & Ακαδημίας 55).
						<br /><br />
						Για να ενημερωθείτε για τα νέα τεύχη ακολουθείστε μας στο
						facebook.
					</p>
				</div>
			</div>
		</div>
	</main>
</BasePage>
