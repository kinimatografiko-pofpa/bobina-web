---
import OptimizedPicture from './OptimizedPicture.astro';
import { parse } from 'node-html-parser';
import wordpress from '../wordpress';

const { posts } = Astro.props;

---

<style>
	.color_overlay {
		background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5));
	}
</style>

<div
	class="flex gap-5 px-5 md:justify-between w-screen md:w-full mx-auto overflow-x-auto max-w-[1200px] pb-7"
>
	{
	posts.map((post) => (
		<article class='group relative overflow-hidden sm:h-[420px] md:h-[520px] w-[70vw] md:w-[60vw] lg:max-w-[360px] shrink-0 grow-0'>
			<a href={'/posts/' + post.slug}>
				<div class="flex flex-col text-white h-full">
					<h1 class="title-medium md:title-xlarge mt-7 pt-4 px-4 mb-16 md:mb-0">
						{parse(post.title).text}
					</h1>
					<div class="relative mt-auto z-0">
						<div class="text-body-small px-3 pt-4 pb-6">
							{wordpress.getExcerptFromPost(post, 120)}
						</div>
						<div
							class="-z-10 absolute bg-primary bg-opacity-70 transition-all top-0 right-0 left-0 h-full"
						>
						</div>
					</div>
				</div>

				<div class="color_overlay absolute top-0 left-0 w-full h-full -z-10"></div>
				<OptimizedPicture
					src={post.featured_image}
					class="bg-cover bg-center absolute top-0 w-full h-full -z-20 transition-all group-hover:scale-105"
					alt={post.title}
					style='linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5))'
				/>
			</a>
		</article>
	))
	}
</div>