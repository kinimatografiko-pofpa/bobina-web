---
import OptimizedPicture from './OptimizedPicture.astro';
import wordpress from '../wordpress';
import { parse } from 'node-html-parser';

let {
	data: { posts },
} = await wordpress.getPosts(1);

let post = posts[0];

let post_categories = wordpress.getCategoriesFromPost(post);
---

<article class="md:grid md:grid-flow-col md:auto-cols-fr">
		<a
			href={`/posts/${post.slug}`}
			class="h-[240px] bg-black md:min-h-full flex"
		>

			<OptimizedPicture
				src={post.featured_image}
				alt={parse(post.title).text}
				class="object-cover grow"
			/>
		</a>
		<div class="md:pt-12 md:pb-9 md:pl-14 md:pr-11 flex flex-col content-center">
			<p class="text-overline mt-6">
				{
					post_categories.map((c) => (
						<a
							href={'/categories/' + c.slug}
							class="hover:text-primary_bold"
						>
							{
								c.name
								.normalize('NFD')/*decompose accented characters into: character + diacritical mark*/
								.replace(/[\u0300-\u036f]/g, "")/*remove diacritical marks from name*/
							}
						</a>
					))
				}
			</p>
			
			<a href={`/posts/${post.slug}`}><h3 class="title-large my-4 hover:text-primary_bold">{parse(post.title).text}</h3></a>
			<p class="text-body">
				{wordpress.getExcerptFromPost(post)}
			</p>
		</div>
</article>