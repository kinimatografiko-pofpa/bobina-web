---
import wordpress from '../wordpress';

let { data: categories } = await wordpress.getCategories();

//script here
const categories_filtered = categories.filter((category) => category.ID != wordpress.NO_CATEGORY);/* Remove 'uncategorized' category since it's not in use 
Maybe we can remove it from wordpress itself*/
const items = [
	{
		href: '/about',
		text: 'Σχετικά',
	},
	{
		href: null,
		text: 'Κατηγορίες',
		subitems: categories_filtered.map((c) => {
			if (c.ID == wordpress.DEFAULT_CATEGORY) {
				return {
					text: 'Όλα τα άρθρα',
					href: '/posts',
				};
			}
			return {
				text: c.name,
				href: '/categories/' + c.slug,
			};
		}),
	},
	{
		href: '/contact',
		text: 'Επικοινωνία',
	},
];
---

<style>
	.dropdown-menu {
		top: 100%; /* 3px is the border size */
		left: 0;
		right: 0;
		z-index: 100;
	}

	.dropdown.expand > .dropdown-menu  {
		display: block;
	}
</style>

<nav
	class="flex justify-evenly md:justify-center mt-4 border-t-3 border-b-3 border-black text-center relative"
>
	{
		items.map((it) => {
			return (it.href != null ? (
				// Link
				<div class="min-h-full hover:bg-black hover:text-white">
					<a href={it.href} class="min-h-full title-small px-5 md:px-10 py-2 text-center mx-auto inline-block focus-visible:bg-black focus-visible:text-white">
						{it.text}
					</a>
				</div>
			) : (
				// Dropdown menu
				<div class="dropdown hover:bg-black hover:text-white  [&.expand]:bg-black [&.expand]:text-white ">
					<button class="dropdown-btn min-h-full title-small px-5 md:px-10 py-2 focus-visible:bg-black focus-visible:text-white">
						{it.text}
					</button>

					{it.subitems != null ? (
						<div class="dropdown-menu absolute hidden bg-white text-black  border-t-3 border-black py-1 drop-shadow-3xl w-full">
							<ul class="inline-block">
								{it.subitems.map((i) => (
									<a class="hover:underline mx-auto" href={i.href}>
										<li class="py-3 title-small px-4">
											{i.text}
										</li>
									</a>
								))}
							</ul>
						</div>
					) : (
						''
					)}
				</div>
			)
			);
		})
	}
</nav>


<script define:vars={{categories}}>
	var nav_items = Array.from(document.getElementsByClassName('dropdown'));

	nav_items.forEach(function(dropdown) {
		const button = dropdown.querySelector('.dropdown-btn');

		// Dropdown button toggle
		button.addEventListener('click', function () {
	 		dropdown.classList.toggle("expand");
	 	});

		// Click outside dropdown menu - close
		document.addEventListener('click', function (event) {
			if(dropdown.contains(event.target)){
				return;
			}
			dropdown.classList.remove("expand");
		});
	});
</script>