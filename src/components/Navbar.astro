---
import wordpress from '../wordpress';

let { data: categories } = await wordpress.getCategories();

//script here
const items = [
	{
		href: '/about',
		text: 'Σχετικά',
	},
	{
		href: null,
		text: 'Κατηγορίες',
		subitems: categories.map((c) => {
			if (c.ID == wordpress.DEFAULT_CATEGORY) {
				return {
					text: 'Όλα τα άρθρα',
					href: '/posts',
				};
			}
			return {
				text: c.name,
				href: '/categories/' + c.slug,
			};
		}),
	},
	{
		href: '/contact',
		text: 'Επικοινωνία',
	},
];
---

<style>
	.dropdown {
		top: 100%; /* 3px is the border size */
		left: 0;
		right: 0;
		z-index: 100;
	}

	.dropdown-btn.expand + .dropdown  {
		display: block;
	}
</style>

<nav
	class="flex justify-evenly md:justify-center mt-4 border-t-3 border-b-3 border-black text-center relative"
>
	{
		items.map((it) => {
			return (
				<div class="group min-h-full hover:bg-black hover:text-white  [&>.dropdown-btn.expand]:bg-black [&>.dropdown-btn.expand]:text-white">
					{it.href != null ? (
						// Link
						<a href={it.href} class="min-h-full title-small px-5 md:px-10 py-2 text-center mx-auto inline-block focus-visible:bg-black focus-visible:text-white">
							{it.text}
						</a>
					) : (
						// Dropdown menu expand button
						<button class="dropdown-btn min-h-full title-small px-5 md:px-10 py-2 focus-visible:bg-black focus-visible:text-white">
							{it.text}
						</button>
					)}
					{it.subitems != null ? (
						// Dropdown menu
						<div class="dropdown absolute hidden bg-white text-black  border-t-3 border-black py-1 drop-shadow-3xl w-full">
							<ul class="inline-block">
								{it.subitems.map((i) => (
									<a class="hover:underline mx-auto" href={i.href}>
										<li class="py-3 title-small px-4">
											{i.text}
										</li>
									</a>
								))}
							</ul>
						</div>
					) : (
						''
					)}
				</div>
			);
		})
	}
</nav>


<script>
	const nav_items = document.getElementsByClassName('dropdown-btn');
	var i: number;

	for (i = 0; i < nav_items.length; i++) {
	 	nav_items[i].addEventListener('click', function () {
	 		this.classList.toggle("expand");
	 	});

		nav_items[i].addEventListener("blur", function() {
			this.classList.remove("expand");
		});
	}
</script>