---
import wordpress from '../wordpress';
import { getCollection } from 'astro:content';

let categories = await getCollection('categories');
categories = categories.map((c) => {
	return c.data;
});

const items = [
	{
		href: '/about',
		text: 'Σχετικά',
	},
	{
		href: null,
		text: 'Κατηγορίες',
		subitems: categories.map((c) => (
			{
				text: c.name,
				href: c.href,
			}
		)),
	},
	{
		href: '/contact',
		text: 'Επικοινωνία',
	},
];
---

<style>
	.dropdown-menu {
		top: 100%; /* 3px is the border size */
		left: 0;
		right: 0;
		z-index: 100;
	}

	.dropdown.expand > .dropdown-menu  {
		display: block;
	}
</style>

<nav
	class="w-full mt-4 border-t-3 border-b-3 border-black text-center relative"
>
	<div class="inline-grid grid-flow-col auto-cols-fr mx-auto w-full sm:w-auto overflow-y-hidden">
	{
		items.map((it) => {
			return (it.href != null ? (
				// Link
				<div class="min-h-full hover:bg-black hover:text-white">
					<a href={it.href} class="min-h-full w-full title-xsmall sm:title-small px-1 sm:px-5 md:px-10 py-2 text-center mx-auto inline-block focus-visible:bg-black focus-visible:text-white">
						{it.text}
					</a>
				</div>
			) : (
				// Dropdown menu
				<div class="dropdown hover:bg-black hover:text-white  [&.expand]:bg-black [&.expand]:text-white">
					<button class="dropdown-btn min-h-full w-full title-xsmall sm:title-small px-1 sm:px-5 md:px-10 py-2 focus-visible:bg-black focus-visible:text-white">
						{it.text}
					</button>

					{it.subitems != null ? (
						<div class="dropdown-menu absolute hidden bg-white text-black  border-t-3 border-black py-1 drop-shadow-3xl w-full">
							<ul class="inline-block">
								{it.subitems.map((i) => (
									<a class="hover:underline mx-auto" href={i.href}>
										<li class="py-3 title-xsmall sm:title-small px-4">
											{i.text}
										</li>
									</a>
								))}
							</ul>
						</div>
					) : (
						''
					)}
				</div>
			)
			);
		})
	}
	</div>
</nav>


<script>
	/* Dropdown Menu functionality */

	var nav_items = Array.from(document.getElementsByClassName('dropdown'));

	nav_items.forEach(function(dropdown) {
		const button = dropdown.querySelector('.dropdown-btn');

		// Dropdown expand button pressed - toggle dropdown menu
		button.addEventListener('click', function () {
	 		dropdown.classList.toggle("expand");
	 	});

		// Click is outside dropdown menu - close dropdown menu
		document.addEventListener('click', function (event) {
			if(dropdown.contains(event.target as HTMLElement)){
				return;
			}
			dropdown.classList.remove("expand");
		});
	});
</script>