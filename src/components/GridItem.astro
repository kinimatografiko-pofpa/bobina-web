---
import OptimizedPicture from './OptimizedPicture.astro';

const { href, class: cl, img ,alt='', img_style, overlay_color='rgba(0, 0, 0, 0)',overlay_opacity='100%',overlay_filter='',position} = Astro.props;
---

<style
	define:vars={{ 
		color: `${overlay_color}` ,
		opacity: `${overlay_opacity}` ,
		filter: `${overlay_filter}`
	}}
>
	.color_overlay {
		background-color: var(--color);
		filter: var(--filter);
		opacity: var(--opacity);
	}
</style>

<a
	href={href}
	class:list={['relative z-0 group overflow-hidden',cl]}
>
	<div class="color_overlay absolute top-0 left-0 w-full h-full z-20"></div>
	<OptimizedPicture
		src={img}
		alt={alt}
		class="group-hover:scale-110 transition grow object-cover"
		style={img_style}
		objectPosition={position}
	/>
	<div
		class="absolute top-0 bottom-0 left-0 w-full h-full flex justify-center align-middle z-30"
	>
		<h5 class="relative title-medium my-auto text-white mx-2 text-center" style="text-shadow: 0px 0px 25px black;" ><slot/></h5>
	</div>
</a>
