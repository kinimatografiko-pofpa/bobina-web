---
// Base layout for all the pages in this blog, includes some SEO tags as well as the header, footer and analytics.

import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';

export interface Props {
	title: string;
	description?: string;
	permalink: string;
	thumbnail?: string;
}

const { title, description, permalink, thumbnail } = Astro.props;
---

<html lang="el">
	<head>
		<BaseHead {title} {description} {permalink} {thumbnail}/>
	</head>

	<body>
		<Analytics />
		<BlogHeader />

		<slot />

		<Footer />
	</body>
</html>
